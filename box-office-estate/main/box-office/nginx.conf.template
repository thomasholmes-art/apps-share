# nginx configuration for box-office. Part of box-office-estate
# (module 07, lab 07-hackathon-two-worlds).
#
# Serves the built front end and forwards /api/* to orders-api with the
# prefix removed. The upstream is resolved on each request (resolver plus a
# variable), so a rebuilt orders-api container with a new address is found.
server {
  listen 80;
  root /usr/share/nginx/html;
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
  set $orders_api http://orders-api:4000;

  location /api/ {
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $orders_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_read_timeout 30s;
  }

  location / {
    try_files $uri /index.html;
  }
}
